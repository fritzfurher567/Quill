# Quill website environment variables.
# Copy to `.env.local` for local development; set the same names in the Vercel
# project settings (Settings -> Environment Variables) for deployment.

# --- Repository -------------------------------------------------------------
# The public GitHub repository that publishes Quill's installers, as
# "owner/name". It is public information, so it is safe to expose to the browser
# (that is what the NEXT_PUBLIC_ prefix does). It drives the GitHub and
# "Releases" links and the download data.
#
# If this variable is left unset, the site falls back to the repository named
# below. Set it to an EMPTY value (NEXT_PUBLIC_GITHUB_REPO=) to see the
# "repository not configured" state, which disables downloads and GitHub links
# instead of pointing at a guessed address.
NEXT_PUBLIC_GITHUB_REPO=fritzfurher567/Quill

# --- Production URL (optional) -----------------------------------------------
# The final public origin, e.g. https://example.com (no trailing slash).
# Only when this is set does the site emit a canonical URL, absolute Open Graph
# URLs, a sitemap entry and a sitemap line in robots.txt. Leave it unset until
# the real domain is known; no domain is guessed.
NEXT_PUBLIC_SITE_URL=

# --- GitHub token (optional, server-side only) --------------------------------
# Not required: Quill's repository is public, so release data is read without
# authentication. Anonymous requests are limited to 60 per hour per IP address,
# which a shared build server can exhaust. A token raises that limit.
# A fine-grained token with NO permissions (public read-only) is enough.
# This variable is deliberately NOT prefixed with NEXT_PUBLIC_, so it is never
# sent to the browser. Never commit a real token.
GITHUB_TOKEN=
